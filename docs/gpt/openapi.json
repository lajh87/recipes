{
  "openapi": "3.1.0",
  "info": {
    "title": "Heley Family Cookbook GPT API",
    "description": "Search the private cookbook, retrieve complete recipes, and read or save weekly meal plans.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://recipes-open.heley.uk"
    }
  ],
  "paths": {
    "/api/search": {
      "get": {
        "summary": "Search Recipes",
        "description": "Search by keywords and/or required ingredients (all ingredients must match).",
        "operationId": "search_recipes",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Query"
            }
          },
          {
            "name": "ingredients",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ingredients"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/recipes/{recipe_id}": {
      "get": {
        "summary": "Get Recipe",
        "description": "Fetch full details before summarising, checking dietary suitability or calculating shopping quantities.",
        "operationId": "get_recipe",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Recipe Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meal-plans/{start_on}": {
      "get": {
        "summary": "Get Meal Plan",
        "description": "Read a saved week without changes. A missing week returns 404.",
        "operationId": "get_meal_plan",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "start_on",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Start On"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeekResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Meal Plan",
        "description": "Replace all meals and notes only on an explicit replacement request. Read the existing week first.",
        "operationId": "update_meal_plan",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "start_on",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Start On"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeekUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeekResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": true
      }
    },
    "/api/meal-plans": {
      "post": {
        "summary": "Create Meal Plan",
        "description": "Save a draft only when requested. Returns 409 if this week already exists; never auto-replace it.",
        "operationId": "create_meal_plan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeekCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeekResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "x-openai-isConsequential": true
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngredientRecord": {
        "properties": {
          "raw": {
            "type": "string",
            "title": "Raw"
          },
          "normalized_name": {
            "type": "string",
            "title": "Normalized Name"
          },
          "canonical_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Name"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "item": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item"
          },
          "preparation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preparation"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "raw",
          "normalized_name"
        ],
        "title": "IngredientRecord"
      },
      "Meal": {
        "properties": {
          "weekday": {
            "type": "string",
            "title": "Weekday"
          },
          "meal": {
            "type": "string",
            "title": "Meal"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipe Id"
          }
        },
        "type": "object",
        "required": [
          "weekday",
          "meal",
          "title",
          "recipe_id"
        ],
        "title": "Meal"
      },
      "PlannedMeal": {
        "properties": {
          "weekday": {
            "type": "string",
            "enum": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ],
            "title": "Weekday"
          },
          "meal": {
            "type": "string",
            "enum": [
              "Breakfast",
              "Lunch",
              "Dinner"
            ],
            "title": "Meal",
            "default": "Dinner"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipe Id",
            "description": "ID returned by search_recipes."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Required for a meal without a recipe_id.",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "weekday"
        ],
        "title": "PlannedMeal"
      },
      "RecipeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "cookbook": {
            "type": "string",
            "title": "Cookbook"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientRecord"
            },
            "type": "array",
            "title": "Ingredients"
          },
          "method_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Method Steps"
          },
          "metadata": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "type": "object",
            "title": "Metadata"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "review_status": {
            "type": "string",
            "title": "Review Status"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "recipe_path": {
            "type": "string",
            "title": "Recipe Path"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "cookbook",
          "ingredients",
          "method_steps",
          "metadata",
          "source",
          "review_status",
          "warnings",
          "recipe_path"
        ],
        "title": "RecipeResponse"
      },
      "SearchItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "cookbook": {
            "type": "string",
            "title": "Cookbook"
          },
          "ingredient_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ingredient Names"
          },
          "recipe_path": {
            "type": "string",
            "title": "Recipe Path"
          },
          "matched_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Terms"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "cookbook",
          "ingredient_names",
          "recipe_path",
          "matched_terms",
          "score"
        ],
        "title": "SearchItem"
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "ingredients": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ingredients"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SearchItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "query",
          "ingredients",
          "count",
          "items"
        ],
        "title": "SearchResponse"
      },
      "Source": {
        "properties": {
          "chapter_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chapter Title"
          },
          "page_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Start"
          },
          "page_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page End"
          }
        },
        "type": "object",
        "required": [
          "chapter_title",
          "page_start",
          "page_end"
        ],
        "title": "Source"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WeekCreate": {
        "properties": {
          "meals": {
            "items": {
              "$ref": "#/components/schemas/PlannedMeal"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Meals"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          },
          "start_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Start On",
            "description": "First date of the seven-day plan, YYYY-MM-DD."
          }
        },
        "type": "object",
        "required": [
          "meals",
          "start_on"
        ],
        "title": "WeekCreate"
      },
      "WeekResponse": {
        "properties": {
          "week_id": {
            "type": "string",
            "title": "Week Id"
          },
          "week_title": {
            "type": "string",
            "title": "Week Title"
          },
          "start_on": {
            "type": "string",
            "title": "Start On"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          },
          "meal_plan_path": {
            "type": "string",
            "title": "Meal Plan Path"
          },
          "meals": {
            "items": {
              "$ref": "#/components/schemas/Meal"
            },
            "type": "array",
            "title": "Meals"
          }
        },
        "type": "object",
        "required": [
          "week_id",
          "week_title",
          "start_on",
          "notes",
          "meal_plan_path",
          "meals"
        ],
        "title": "WeekResponse"
      },
      "WeekUpdate": {
        "properties": {
          "meals": {
            "items": {
              "$ref": "#/components/schemas/PlannedMeal"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Meals"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "description": "Complete week notes; retained notes must be included when replacing a week."
          }
        },
        "type": "object",
        "required": [
          "meals",
          "notes"
        ],
        "title": "WeekUpdate"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
